# Obrigatório — copie para .env e preencha com os valores do projeto Supabase
# Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Após alterar o .env, reinicie o bundler:
#   pnpm exec expo start --clear
#
# Auth → URL Configuration → Redirect URLs (adicione):
#   amply://
#   exp://127.0.0.1:8081/--/
#   exp://localhost:8081/--/
#   (e o exp:// do seu IP se usar dispositivo físico)
#
# Auth → Providers → Email:
#   "Confirm email" = ligado → usuário recebe e-mail de confirmação
#   SMTP: use o padrão do Supabase ou configure custom SMTP
#   Em projetos free, e-mails podem ir para spam ou ter rate limit

# NÃO coloque SPOTIFY_CLIENT_SECRET aqui.
# Configure SPOTIFY_CLIENT_ID e SPOTIFY_CLIENT_SECRET apenas nos
# secrets da Edge Function no Supabase.
